# FEATHERLESS_API_KEY: Optional for Featherless AI strategic reasoning.
# If omitted or unavailable, the application runs via deterministic optimization agents.
FEATHERLESS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# BACKEND PORT (Default 3000 for full-stack Node server, 8000 for FastAPI)
PORT=3000

# SQLITE DATABASE FILE LOCATION
SQLITE_DB_PATH="./backend/promopilot.db"

